{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"packageRules": [
		{
			"matchDatasources": ["crate"],
			"matchPackageNames": ["fujo", "fujo-*"],
			"groupName": "fujo crates",
			"separateMajorMinor": false
		}
	],
	"github-actions": {
		"enabled": false
	},
	"forkProcessing": "enabled",
	"baseBranchPatterns": [
		"$default",
		"bench"
	]
}
