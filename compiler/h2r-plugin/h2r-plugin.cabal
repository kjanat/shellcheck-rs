cabal-version:      2.4
name:               h2r-plugin
version:            0.1.0.0
synopsis:           GHC plugin that serialises optimised Core to JSON for the Haskell-to-Rust compiler
license:            GPL-3.0-only
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  H2R.CorePlugin
    build-depends:    base        >= 4.14 && < 5
                    , ghc         >= 9.4  && < 9.9
                    , aeson       >= 2.0  && < 2.3
                    , bytestring  >= 0.10 && < 0.13
                    , containers  >= 0.6  && < 0.9
                    , directory   >= 1.3  && < 1.4
                    , filepath    >= 1.4  && < 1.6
                    , text        >= 1.2  && < 2.2
    default-language: Haskell2010
    ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-imports
