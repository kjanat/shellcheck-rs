{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "rshellcheck": {
      "packages": [
        "pkg:npm/%40kjanat/rshellcheck",
        "pkg:npm/%40kjanat/rshellcheck-wasm",
        "pkg:pypi/rshellcheck-wasm",
        "pkg:pypi/rshellcheck",
        "pkg:cargo/rshellcheck-core",
        "pkg:cargo/rshellcheck",
        "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go"
      ],
      "versionScope": "one-for-stream",
      "mustPublish": [
        "pkg:npm/%40kjanat/rshellcheck",
        "pkg:npm/%40kjanat/rshellcheck-wasm",
        "pkg:pypi/rshellcheck-wasm",
        "pkg:pypi/rshellcheck",
        "pkg:cargo/rshellcheck-core",
        "pkg:cargo/rshellcheck",
        "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go"
      ],
      "needs": {
        "pkg:npm/%40kjanat/rshellcheck": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go",
          "pkg:github/kjanat/shellcheck-rs"
        ],
        "pkg:npm/%40kjanat/rshellcheck-wasm": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go",
          "pkg:github/kjanat/shellcheck-rs"
        ],
        "pkg:pypi/rshellcheck-wasm": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go",
          "pkg:github/kjanat/shellcheck-rs"
        ],
        "pkg:pypi/rshellcheck": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go",
          "pkg:github/kjanat/shellcheck-rs"
        ],
        "pkg:github/kjanat/shellcheck-rs": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go"
        ],
        "pkg:cargo/rshellcheck-core": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go"
        ],
        "pkg:cargo/rshellcheck": [
          "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go",
          "pkg:cargo/rshellcheck-core"
        ]
      },
      "credentials": ["crates-io"],
      "workflows": {
        "crates": {
          "file": "publish-crates.yml",
          "ref": "master",
          "publications": [
            "pkg:cargo/rshellcheck-core",
            "pkg:cargo/rshellcheck"
          ],
          "needs": ["release"],
          "needsJobs": {
            "release": [
              "plan",
              "check",
              "build",
              "bindings",
              "assemble",
              "registry-payload"
            ]
          },
          "setup": {
            "commands": "beepboop publish",
            "credentials": {
              "CARGO_REGISTRY_TOKEN": "crates-io"
            }
          }
        },
        "release": {
          "file": "release.yml",
          "mode": "observe",
          "ref": "refs/tags/rshellcheck-v*",
          "publications": [
            "pkg:npm/%40kjanat/rshellcheck",
            "pkg:npm/%40kjanat/rshellcheck-wasm",
            "pkg:pypi/rshellcheck-wasm",
            "pkg:pypi/rshellcheck",
            "pkg:github/kjanat/shellcheck-rs"
          ],
          "needs": ["promote"]
        }
      },
      "prepare": {
        "strategy": "managed",
        "workflow": {
          "file": "prepare-release.yml",
          "ref": "master",
          "setup": {
            "job": "prepare",
            "commands": "cargo update --workspace\nnpm install --package-lock-only\nuv lock\ncargo test --workspace --locked --lib --bins"
          }
        },
        "versionLands": "via-version-pr"
      },
      "promote": {
        "publishWhen": "version-pr-merged",
        "workflow": {
          "file": "release-rshellcheck.yml",
          "ref": "master",
          "publications": [
            "pkg:golang/github.com/kjanat/shellcheck-rs/bindings/wasm/go"
          ],
          "refs": {
            "phase": "version",
            "prefix": "rshellcheck-v"
          },
          "setup": {
            "job": "promote",
            "tagPrefix": "rshellcheck-v"
          }
        }
      },
      "startFrom": [
        {
          "via": "action",
          "workflow": "start-release.yml"
        },
        {
          "via": "dashboard"
        },
        {
          "via": "cli"
        }
      ],
      "companionModules": ["pkg:golang/github.com/kjanat/shellcheck-rs/go"]
    },
    "go": {
      "packages": ["pkg:golang/github.com/kjanat/shellcheck-rs/go"],
      "versionScope": "one-for-stream",
      "mustPublish": ["pkg:golang/github.com/kjanat/shellcheck-rs/go"],
      "versionSource": {
        "kind": "tags",
        "prefix": "go/v"
      },
      "prepare": {
        "strategy": "managed",
        "workflow": {
          "file": "prepare-go.yml",
          "ref": "master",
          "setup": {
            "job": "prepare",
            "commands": "(cd 'go' && go mod tidy -diff)"
          }
        }
      },
      "promote": {
        "publishWhen": "approved-in-beepboop",
        "workflow": {
          "file": "release-go.yml",
          "ref": "master",
          "publications": ["pkg:golang/github.com/kjanat/shellcheck-rs/go"],
          "refs": {
            "phase": "version",
            "prefix": "go/v"
          },
          "setup": {
            "job": "promote",
            "tagPrefix": "go/v"
          }
        }
      }
    }
  },
  "managers": ["cargo", "go", "npm", "pypi", "workflow"]
}
