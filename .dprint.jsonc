{
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat@master/configs/dprint.remote.json",
	"plugins": ["npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"],
	"excludes": [".github/ISSUE_TEMPLATE/*.md"],
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [
			{
				"command": "tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "mise i",
			},
			// { "command": "rustfmt", "exts": ["rs"], "cacheKeyFiles": ["rustfmt.toml"], "setupCommand": "mise i" },
		],
	},
	"markdown": { "associations": ["!shellcheck.1.md"] },
	"json": {
		"jsonTrailingCommaFiles": [".{vscode,zed}/*.json", ".dprint.json"],
		"trailingCommas": "jsonc",
	},
	"shfmt": {
		"associations": [
			"!**/*.hs",
			".github_deploy",
			".multi_arch_docker",
			".prepare_deploy",
			"manpage",
			"nextnumber",
			"quickrun",
			"quicktest",
			"setgitversion",
			"striptests",
			"test/*",
		],
	},
}
