{
	"excludes": [
		"**/.bench/**",
		"ports/**",
		"source/**",
		"compiler/**",
		"dist-newstyle/**",
		"probe*.py",
		"results/**",
		"**/target/**",
		".github/ISSUE_TEMPLATE/*.md",
		"results/**/*.json",
	],
	"markdown": {
		"list.unorderedMarker": "asterisks",
		"maxBlankLines": 2,
		"codeBlock.preserveBlankLines": true,
		"overrides": [
			{
				"files": [".claude/**/*.md", "**/CLAUDE.md"],
				"list.unorderedMarker": "dashes",
				"table.skipFormat": true
			},
			{
				"files": ["README.md", "docs/**/*.md", "results/**/*.md"],
				"list.unorderedMarker": "dashes",
				"textWrap": "never"
			}
		],
		"associations": ["!CHANGELOG.md"]
	},
	"ruff": {
		"preview": true,
		"fixLintErrors": {
			"missingRequiredImport": false,
			"unsortedImports": false,
			"unusedImport": false
		}
	},
	"toml": {
		"configFile": "tombi.toml"
	},
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/refs/heads/master/configs/dprint.remote.json",
}
