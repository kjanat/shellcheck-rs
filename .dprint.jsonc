{
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/refs/heads/master/configs/dprint.remote.json",
	"plugins": ["npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"],
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [
			{
				"command": "mise exec -- tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml", "mise.toml"],
			},
			{
				"command": "mise exec -- rustfmt",
				"exts": ["rs"],
				"cacheKeyFiles": ["rustfmt.toml", "mise.toml"]
			}
		]
	},
	"excludes": ["shellcheck.1.md", ".github/ISSUE_TEMPLATE/*.md"],
	"shfmt": {
		"associations": [
			"test/*",
			"!test/shellcheck.hs",
			".github_deploy",
			".multi_arch_docker",
			".prepare_deploy",
			"manpage",
			"nextnumber",
			"quickrun",
			"quicktest",
			"setgitversion",
			"striptests",
		]
	}
}
