{
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [
			{
				"command": "mise exec -- tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml", "mise.toml"],
			},
		]
	},
	"excludes": [
		"**/.bench/{bin,src}",
		"**/target/**",
		".github/ISSUE_TEMPLATE/*.md",
		"bench/results/**/*.json",
		"shellcheck.1.md"
	],
	"shfmt": {
		"associations": [
			"test/*",
			"!test/shellcheck.hs",
			".github_deploy",
			".multi_arch_docker",
			".prepare_deploy",
			"manpage",
			"nextnumber",
			"quickrun",
			"quicktest",
			"setgitversion",
			"striptests"
		]
	},
	"markdown": {
		"list.unorderedMarker": "asterisks",
		"maxBlankLines": 2,
		"codeBlock.preserveBlankLines": true,
		"overrides": [
			{
				"files": [".claude/**/*.md", "**/CLAUDE.md"],
				"list.unorderedMarker": "dashes",
				"table.skipFormat": true
			},
			{
				"files": ["bench/**/*.md"],
				"list.unorderedMarker": "dashes",
				"textWrap": "never"
			}
		],
		"associations": ["!CHANGELOG.md"]
	},
	"yaml": {
		"overrides": [
			{
				"files": ["stack.yaml"],
				"quotes": "preferSingle",
				"indentBlockSequenceInMap": false
			}
		]
	},
	"ruff": {
		"preview": true,
		"fixLintErrors": {
			"missingRequiredImport": false,
			"unsortedImports": false,
			"unusedImport": false
		}
	},
	"plugins": ["npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"],
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/refs/heads/master/configs/dprint.remote.json",
}
